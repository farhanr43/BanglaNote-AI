# ============================================================================
# BanglaNote AI — environment / secret reference
#
# 1. FRONTEND (Vercel build env) — does NOT hold any Gemini key
#    VITE_EDGE_FUNCTION_URL=https://<project-ref>.functions.supabase.co/ai-proxy
#
# 2. SUPABASE EDGE FUNCTION SECRETS  (supabase secrets set ...)
#    PROJECT_URL=https://<project-ref>.supabase.co
#    SERVICE_ROLE_KEY=<service_role key from Dashboard -> Settings -> API>
#    GEMINI_API_KEY=<Google AI Studio key>
#    (CLI blocks names starting with "SUPABASE_", hence PROJECT_URL / SERVICE_ROLE_KEY.)
#
# Set with:
#   supabase secrets set PROJECT_URL=... SERVICE_ROLE_KEY=... GEMINI_API_KEY=...
#
# 3. DEPLOY
#   supabase db push
#   supabase functions deploy ai-proxy --no-verify-jwt
#   supabase functions deploy admin-grant --no-verify-jwt
#
# 4. ADMIN ACCESS
#   Admin actions use the real Supabase session: the user must be logged in AND
#   their profile must have is_admin = true:
#     update public.profiles set is_admin = true where id = '<auth.users id>';
# ============================================================================
